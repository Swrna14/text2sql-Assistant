# Copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite:///./demo.db
# MySQL example: mysql+pymysql://readonly_user:password@localhost:3306/shop
# PostgreSQL example: postgresql+psycopg2://readonly_user:password@localhost:5432/shop

LLM_PROVIDER=gemini        # gemini | mock (mock needs no API key)
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash

JWT_SECRET=generate-a-long-random-string
JWT_EXPIRE_MINUTES=60
MAX_ROWS=100
